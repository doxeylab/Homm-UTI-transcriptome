```{r Temp: rebuild model with ranked genes}

imp <- importance(rf_100, type = 1)
imp <- sort(imp[,1], decreasing = TRUE)

run_rf <- function(gene_set, use_rpm = FALSE) {

  feature_cols <- gene_set
  if (use_rpm) {
    feature_cols <- c(feature_cols, "rpm_sums")
  }

  rf <- randomForest(
    x = mega_tpm_values_100[train_idx, feature_cols, drop = FALSE],
    y = mega_tpm_values_100$class[train_idx],
    ntree = 1000
  )

  pred_prob <- predict(
    rf,
    newdata = mega_tpm_values_100[test_idx, feature_cols, drop = FALSE],
    type = "prob"
  )[,"yes"]

  roc_obj <- roc(
    mega_tpm_values_100$class[test_idx],
    pred_prob
  )

  list(
    auc = auc(roc_obj),
    roc = roc_obj,
    rf  = rf
  )
}



# Remove rpm_sums from ranking
imp_genes <- imp[!names(imp) %in% "rpm_sums"]

# Now define nested gene sets
top1  <- names(imp_genes)[1]
top3  <- names(imp_genes)[1:3]
top5  <- names(imp_genes)[1:5]
top10 <- names(imp_genes)[1:10]

res_1  <- run_rf(top1)
res_3  <- run_rf(top3)
res_5  <- run_rf(top5)
res_10 <- run_rf(top10)

res_1$auc
res_3$auc
res_5$auc
res_10$auc

res_1_rpm  <- run_rf(top1,  use_rpm = TRUE)
res_3_rpm  <- run_rf(top3,  use_rpm = TRUE)
res_5_rpm  <- run_rf(top5,  use_rpm = TRUE)
res_10_rpm <- run_rf(top10, use_rpm = TRUE)

res_1_rpm$auc
res_3_rpm$auc
res_5_rpm$auc
res_10_rpm$auc

```
