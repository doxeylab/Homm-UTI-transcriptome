### See actual model performance now for predicting binary UTI

```{r overall model performance}

# Test -> For 10-gene
sample_3_gene <- unsupervised_val_3_gene$val_predictions
sample_3_gene$ptid <- sample_3_gene$Sample
validation_joined <- Val_venn_df %>%
  inner_join(sample_3_gene, by = "ptid")

validation_joined$clinical_uti_final <- mapply(function(x, y) ifelse(x == y & y == 1, 1, 0), validation_joined$uti, validation_joined$binary_enrleuks)
validation_joined$rnaseq_uti_final <- mapply(function(x, y) ifelse(x == y & y == 1, 1, 0), validation_joined$RPM_sums_binary, validation_joined$Pred)

sample_10_gene <- unsupervised_val_10_gene$val_predictions
sample_10_gene$ptid <- sample_10_gene$Sample
