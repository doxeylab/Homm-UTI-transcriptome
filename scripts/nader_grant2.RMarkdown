pathogen_abundance_auc_thres <- pathogen_abundance_result$threshold
results.df$pa_positive <- sapply(results.df$RPM, function(x) ifelse(x >= pathogen_abundance_auc_thres, TRUE, FALSE))
pathogen_abundance_auc_thres

```

```{r Q3}

# Prereq: Find the patients to use

load('/data/mchomm/Homm-UTI-transcriptome/data/reads.meta.counts.496.RData')
read_threshold <- 0
patients_df <- reads.meta.counts.496[reads.meta.counts.496$total.reads >= read_threshold , c(1:25)]
patients <- patients_df$ptid

# Part 1: Apply host response signature

# Load the txi df, add all of the relevant columns
txi <- txi.data
CSF_496 <- txi$abundance[CSF3R_ensembl , ]
patients_df$CSF3R_abundance <- CSF_496[as.character(patients_df$ptid)]
patients_df$host_response_binary <- ifelse(patients_df$CSF3R_abundance > host_response_auc_thres, 1, 0)
patients_df$enrleuks_binary <- ifelse(patients_df$enrleuks == 1, 0, ifelse(!is.na(patients_df$enrleuks), 1, NA))
table(patients_df$host_response_binary == 1 & (patients_df$enrleuks >= 2 & !is.na(patients_df$enrleuks)))
table(patients_df$host_response_binary == 1 & patients_df$uti == 1)

roc_obj <- roc(response = patients_df$enrleuks_binary, predictor = patients_df$CSF3R_abundance, direction = "<")
coords_df <- coords(roc_obj, x = "best", best.method = "youden", ret = c("threshold", "sensitivity", "specificity"), transpose = FALSE)
optimal_threshold <- coords_df$threshold


# Part 2: Apply pathogen abundance signature

load("/data/mchomm/Homm-UTI-transcriptome/data/bracken_rpm_496.RData")

seven.pathogens <- c("Escherichia coli", "Klebsiella pneumoniae", "Enterococcus faecalis", "Proteus mirabilis", 
                     "Pseudomonas aeruginosa", "Staphylococcus saprophyticus", "Streptococcus agalactiae") 

bracken_subset <- bracken_rpm_496[ , colnames(bracken_rpm_496) %in% seven.pathogens]
rpm_sums_496 <- rowSums(bracken_subset, na.rm = TRUE)
patients_df$rpm_sums <- rpm_sums_496[as.character(patients_df$ptid)]

roc_obj <- roc(response = patients_df$uti, predictor = patients_df$rpm_sums, direction = "<")
patients_df$pathogen_abundance_binary <- ifelse(patients_df$rpm_sums > pathogen_abundance_auc_thres, 1, 0)

# Put it all together

final_df <- subset(patients_df, select = c(ptid, total.reads, uti, enrleuks_binary, rpm_sums, CSF3R_abundance, pathogen_abundance_binary, host_response_binary))
colnames(final_df) <- c("ptid",
                        "Total Raw RNA-Seq Read Count",
                        "Clinical Pathogen Abundance", 
                        "Clinical LE >= Trace",
                        "RNA-Seq Pathogen Abundance", 
                        "RNA-Seq Host Response Positive (CSF3R Marker)", 
                        "RNA-Seq Pathogen Abundance Binary (14825.84 RPM)", 
                        "RNA-Seq Host Response Binary (71.04148 TPM of CSF3R)")

write.csv(final_df , file = "/data/mchomm/Homm-UTI-transcriptome/misc/nader_grant2/nader_grant_2.csv", row.names = TRUE, quote = FALSE)

