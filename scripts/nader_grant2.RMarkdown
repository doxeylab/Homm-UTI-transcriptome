### DESeq2 -> Output should be a sorted results.df

```{r obtain DESeq2 results data frame}

# 1) -> Supervised
supervised.metadata <- reads.meta.counts[colnames(txi.data$abundance) , c("ptid", "enrleuks", "uti")]
supervised.metadata$ptid <- as.character(supervised.metadata$ptid)
# supervised.metadata <- supervised.metadata[!is.na(supervised.metadata$enrleuks) , ]
supervised.metadata$binary_enrleuks <- as.factor(sapply(supervised.metadata$enrleuks, function(x) ifelse(x == 1 | is.na(x), '0', '1')))
supervised.dds <- DESeqDataSetFromTximport(txi.data, colData = supervised.metadata, design = ~binary_enrleuks)
# colData(supervised.dds)$binary_enrleuks <- as.factor(colData(supervised.dds)$binary_enrleuks)
supervised.dds <- DESeq(supervised.dds)

supervised.res <- results(supervised.dds, contrast = c("binary_enrleuks", '1', '0'))
supervised.res.df <- as.data.frame(supervised.res)
supervised.res.df$symbol <- mapIds(org.Hs.eg.db, keys = rownames(supervised.res.df), keytype = "ENSEMBL", column = "SYMBOL")

# 2) -> Unsupervised
unsupervised.metadata <- pred.df
unsupervised.metadata$ptid <- rownames(unsupervised.metadata)
unsupervised.metadata <- full_join(supervised.metadata, unsupervised.metadata, by = "ptid")
unsupervised.metadata[is.na(unsupervised.metadata)] <- 0

# Run deseq
colnames(unsupervised.metadata)[
  colnames(unsupervised.metadata) == "RNA-Seq Host Response Cluster"
] <- "host_cluster"
unsupervised.metadata$host_cluster <- as.character(unsupervised.metadata$host_cluster)
unsupervised.dds <- DESeqDataSetFromTximport(
  txi.data,
  colData = unsupervised.metadata,
  design = ~ host_cluster
)
unsupervised.dds <- DESeq(unsupervised.dds)

unsupervised.res <- results(unsupervised.dds, contrast = c("host_cluster", '1', '0'))
unsupervised.res.df <- as.data.frame(unsupervised.res)
unsupervised.res.df$symbol <- mapIds(org.Hs.eg.db, keys = rownames(unsupervised.res.df), keytype = "ENSEMBL", column = "SYMBOL")

```

### Compare DEG overlap b/w the two

```{r gene overlap}

# See how many genes overlap, padj < 0.05 and log2FoldChange > 1
supervised_genes <- rownames(
  supervised.res.df %>%
    filter(log2FoldChange >= 1, !is.na(symbol)) %>%
    arrange(pvalue) %>%
    slice_head(n = 10)
)

unsupervised_genes <- rownames(
  unsupervised.res.df %>%
    filter(log2FoldChange >= 1, !is.na(symbol)) %>%
    arrange(pvalue) %>%
    slice_head(n = 10)
)

# Intersecting genes
common_genes <- intersect(supervised_genes, unsupervised_genes)

# Unique to each set
only_supervised <- setdiff(supervised_genes, unsupervised_genes)
only_unsupervised <- setdiff(unsupervised_genes, supervised_genes)

# Tabular summary
comparison_table <- data.frame(
  Category = c("Common to both", "Only in supervised", "Only in unsupervised"),
  Count = c(length(common_genes), length(only_supervised), length(only_unsupervised))
)

library(VennDiagram)
venn.plot <- draw.pairwise.venn(
  area1 = length(supervised_genes),
  area2 = length(unsupervised_genes),
  cross.area = length(intersect(supervised_genes, unsupervised_genes)),
  category = c("Supervised", "Unsupervised"),
  fill = c("skyblue", "lightgreen"),
  lty = "blank",
  cex = 1.5,
  cat.cex = 1.2
)
grid.draw(venn.plot)

```

### Compare enrichment for both volcano plots

```{r pathway enrichment}

enrichment <- function(res.df, padj_thres, log2fc_thres, up.or.down, save = FALSE) {

  if (up.or.down == "up") {
    sig.genes <- rownames(res.df[res.df$log2FoldChange > log2fc_thres & res.df$padj < padj_thres, ])
    sig.genes <- sig.genes[!is.na(sig.genes) & !grepl("^NA", sig.genes)]
    title = "Upregulated Pathways"
  } else {
    sig.genes <- rownames(res.df[res.df$log2FoldChange < -log2fc_thres & res.df$padj < padj_thres, ])
    sig.genes <- sig.genes[!is.na(sig.genes) & !grepl("^NA", sig.genes)]
    title = "Downregulated Pathways"
  }
  
  # Run GO analysis
  GO_results <- enrichGO(gene = sig.genes, OrgDb = "org.Hs.eg.db", keyType = "ENSEMBL", ont = "BP")
  GO_results_df <- as.data.frame(GO_results)
  
  # Print p-values for debugging
  print("Original p.adjust values:")
  print(head(GO_results_df$p.adjust))
  
  # Create plot using the enrichResult object (GO_results)
  fit.up <- barplot(GO_results, showCategory = 20) +
    xlab("Number of Genes") + 
    ggtitle(title) + 
    theme(
      plot.title = element_text(size = 15, face = "bold", hjust = 0.5), 
      axis.text.y = element_text(size = 12)
    ) +
    scale_fill_gradient(
      low = "#e73512", 
      high = "#ee794d", 
      name = "Adjusted p-value",
      trans = "log10",  # Log transform for small p-values
      labels = scales::scientific_format()  # Force scientific notation
    )
  
  if (save) {
    ggsave(
      filename = paste0(up.or.down, ".pdf"), 
      plot = fit.up, 
      device = "pdf", 
      width = 12,
      height = 10
    )
  }
  
  print(paste("Number of significant genes:", length(sig.genes)))
  return(fit.up)
}

# Run enrichment function on up/down-regulated genes
supervised_up <- enrichment(supervised.res.df, 0.05, 1, "up", save = FALSE)
unsupervised_up <- enrichment(unsupervised.res.df, 0.05, 1, "up", save = FALSE)

# Finally, find the overlap here

supervised_up_categories <- supervised_up$data$ID
unsupervised_up_categories <- unsupervised_up$data$ID

# Intersecting pwys
common_pwy <- intersect(supervised_up_categories, unsupervised_up_categories)

# Unique to each set
only_supervised_pwy <- setdiff(supervised_up_categories, unsupervised_up_categories)
only_unsupervised_pwy <- setdiff(unsupervised_up_categories, supervised_up_categories)

# Tabular summary
comparison_table_pwy <- data.frame(
  Category = c("Common to both", "Only in supervised", "Only in unsupervised"),
  Count = c(length(common_pwy), length(only_supervised_pwy), length(only_unsupervised_pwy))
)

library(VennDiagram)
venn.plot.pwy <- draw.pairwise.venn(
  area1 = length(supervised_up$data$ID),
  area2 = length(unsupervised_up$data$ID),
  cross.area = length(intersect(supervised_up$data$ID, unsupervised_up$data$ID)),
  category = c("Supervised", "Unsupervised"),
  fill = c("skyblue", "lightgreen"),
  lty = "blank",
  cex = 1.5,
  cat.cex = 1.2
)
grid.draw(venn.plot.pwy)

```

### Function -> output a txi subset with only the top X genes, as well as a correlation matrix for each gene pair

```{r txi subsetting and correlation matrix}

# Create the txi function

subset_txi <- function(results.df, txi, num_genes = 1000, cor_threshold = 0.80, log2FoldChange = 1) {
  
  # Filter out genes below log2FC threshold and with NA padj
  filtered <- results.df[
    !is.na(results.df$padj) &
    results.df$log2FoldChange >= log2FoldChange,
  ]
  
  # Sort by adjusted p-value
  filtered <- filtered[order(filtered$padj), ]
  
  # Initialize
  selected_genes <- character()
  txi_abund <- txi$abundance
  remaining_genes <- rownames(filtered)
  
  for (gene in remaining_genes) {
    # Stop if we've collected enough genes
    if (length(selected_genes) >= num_genes) break
    
    # If this is the first gene, always select it
    if (length(selected_genes) == 0) {
      selected_genes <- c(selected_genes, gene)
    } else {
      # Calculate correlation of current gene to all previously selected
      cor_vals <- cor(t(txi_abund[c(gene, selected_genes), ]), use = "pairwise.complete.obs")
      max_cor <- max(abs(cor_vals[1, -1]))  # correlation of gene to all selected
      
      if (max_cor < cor_threshold) {
        selected_genes <- c(selected_genes, gene)
      }
    }
  }
  
  # Final filtered result and abundance matrices
  final_results <- results.df[selected_genes, ]
  final_abundance <- txi_abund[selected_genes, ]
  
  return(list(results = final_results, abundance = final_abundance))
}


# Call this function

# 1) -> Supervised
supervised.filtered <- subset_txi(results.df = supervised.res.df, txi = txi.data)

# 2) -> Unsupervised
unsupervised.filtered <- subset_txi(results.df = unsupervised.res.df, txi = txi.data)

```

### Function -> Create models using top X genes that don't correlate over Y%

```{r txi subsetting and correlation matrix}

build_model <- function(results.df, txi_abund, class_vector, top_x_genes = 5, cv = TRUE, seed = 42) {
  library(randomForest)
  library(pROC)
  library(caret)
  
  set.seed(seed)

  # 1. Select top genes based on padj
  top_genes <- rownames(results.df[order(results.df$padj), ])[1:top_x_genes]
  
  # 2. Subset abundance matrix (genes = rows, samples = columns)
  abund_sub <- as.data.frame(txi_abund[top_genes, , drop = FALSE])
  
  # 3. Transpose to get: rows = patients, cols = genes
  df <- as.data.frame(t(abund_sub))
  
  if (identical(rownames(df), names(class_vector))) {
    df$label <- factor(class_vector) 
  } else {
    stop("error! names don't match between txi_abund and class_vector")
  }

  auc_result <- NA
  preds_df <- data.frame()
  train_auc <- NA
  auc_per_fold <- NA  # ensure this always exists

  if (cv) {
    folds <- createFolds(df$label, k = 5, returnTrain = TRUE)
    prob_vec <- c()
    pred_vec <- c()
    true_vec <- c()
    auc_per_fold <- c()
  
    for (i in seq_along(folds)) {
      train_idx <- folds[[i]]
      train <- df[train_idx, ]
      test <- df[-train_idx, ]
  
      model <- randomForest(label ~ ., data = train)
      probs <- predict(model, test, type = "prob")[, 2]
      preds <- ifelse(probs >= 0.5, 1, 0)
  
      prob_vec <- c(prob_vec, probs)
      pred_vec <- c(pred_vec, preds)
      true_vec <- c(true_vec, as.numeric(as.character(test$label)))
  
      fold_auc <- auc(roc(as.numeric(as.character(test$label)), probs))
      auc_per_fold <- c(auc_per_fold, fold_auc)
    }
  
    auc_result <- mean(auc_per_fold)
    preds_df <- data.frame(Prob = prob_vec, Pred = pred_vec, True = true_vec)

  } else {
    train_idx <- sample(seq_len(nrow(df)), size = 0.7 * nrow(df))
    train <- df[train_idx, ]
    test <- df[-train_idx, ]

    model <- randomForest(label ~ ., data = train)

    probs <- predict(model, test, type = "prob")[, 2]
    preds <- ifelse(probs >= 0.5, 1, 0)
    true <- as.numeric(as.character(test$label))
    auc_result <- auc(roc(true, probs))

    train_probs <- predict(model, train, type = "prob")[, 2]
    train_true <- as.numeric(as.character(train$label))
    train_auc <- auc(roc(train_true, train_probs))

    preds_df <- data.frame(Prob = probs, Pred = preds, True = true)
  }
  
  # Final model trained on ALL data
  final_model <- randomForest(label ~ ., data = df)
  
  # Final predictions on ALL data
  final_probs <- predict(final_model, df, type = "prob")[, 2]
  final_preds <- ifelse(final_probs >= 0.5, 1, 0)
  final_true <- as.numeric(as.character(df$label))
  
  final_predictions_df <- data.frame(
    Sample = rownames(df),
    Prob = final_probs,
    Pred = final_preds,
    True = final_true
  )

  return(list(
    cv_auc = auc_result,
    fold_aucs = auc_per_fold,
    final_model = final_model,
    final_predictions = final_predictions_df,
    top_genes = top_genes   # ✅ NEW: store top genes used
  ))
}




