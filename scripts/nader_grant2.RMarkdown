### Map gene names back to their gene symbols

```{r map gene ensembl ids back to symbol}

mart <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")

ensembl_ids_unsupervised <- unsupervised_model_1_gene$top_genes
ensembl_ids_supervised <- supervised_model_1_gene$top_genes

gene_map_unsupervised <- getBM(
  attributes = c("ensembl_gene_id", "hgnc_symbol"),
  filters = "ensembl_gene_id",
  values = ensembl_ids_unsupervised,
  mart = mart
)

gene_map_supervised <- getBM(
  attributes = c("ensembl_gene_id", "hgnc_symbol"),
  filters = "ensembl_gene_id",
  values = ensembl_ids_supervised,
  mart = mart
)

gene_map_unsupervised
gene_map_supervised

```

### Retry testing on validation set of patients

```{r validation test pt 2}
library(pROC)

# model_obj: one of your supervised_model_1_gene, etc.
# txi_abund_val: abundance matrix for validation set (genes = rows, samples = cols)
# val_class_vector: named vector of 0/1 (or similar) labels, names = ptid
# threshold: classification threshold (default 0.5)
eval_on_validation <- function(model_obj, txi_abund_val, val_class_vector, threshold = 0.5) {
  # 1. Use the same genes that were used in training
  top_genes <- model_obj$top_genes
  
  common_genes <- intersect(top_genes, rownames(txi_abund_val))
  if (length(common_genes) < length(top_genes)) {
    warning("Some top genes are missing from validation matrix: ",
            paste(setdiff(top_genes, common_genes), collapse = ", "))
  }
  
  # 2. Subset validation abundance to those genes and transpose
  abund_sub_val <- as.data.frame(txi_abund_val[common_genes, , drop = FALSE])
  df_val <- as.data.frame(t(abund_sub_val))   # rows = patients, cols = genes
  
  # 3. Align class vector with samples in df_val
  #    Assumes names(val_class_vector) are ptids matching colnames in txi_abund_val
  val_class_vector <- val_class_vector[rownames(df_val)]
  
  if (any(is.na(val_class_vector))) {
    stop("Some samples in the validation matrix are missing labels.")
  }
  
  # 4. Predict probabilities on the validation set
  probs_val <- predict(model_obj$final_model, newdata = df_val, type = "prob")[, 2]
  preds_val <- ifelse(probs_val >= threshold, 1, 0)
  true_val  <- as.numeric(as.character(val_class_vector))
  
  # 5. Validation AUC
  val_auc <- auc(roc(true_val, probs_val))
  
  # 6. Nice predictions data frame
  predictions_df <- data.frame(
    Sample = rownames(df_val),
    Prob   = probs_val,
    Pred   = preds_val,
    True   = true_val
  )
  
  list(
    val_auc      = val_auc,
    val_predictions = predictions_df
  )
}


# Actually obtain results for the 186 patients

# Validation metadata shortcut (rename if your object is different)
val_meta_unsup <- metadata_885[patients_177 , ]

# Build validation class vector (same transformation as training)
