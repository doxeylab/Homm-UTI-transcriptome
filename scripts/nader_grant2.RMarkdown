## Question 2: Get the UTI signature 3 ways

### Way 1: Using unsupervised host response and pathogen abundance

```{r Q2 A1}

# Load the metadata that will be used

patients.to.remove <- c("15887", "15963", "15985", "15991", "15994", "16003", 
                        "16050", "15860", "15900", "15906", "15927", "16018", 
                        "16089")

metadata <- read_xlsx("/data/mchomm/pathogen_surveillance/data/neelanjay_data/metadata8.9.24.xlsx") %>%
  as.data.frame() %>% 
  filter(goodsample == 1) %>%
  filter(!(ptid %in% patients.to.remove)) %>%
  filter(ptid %in% patients.over.thres)

patients.kept <- metadata$ptid

# Part 1: Host response -> Perform ROC for CSF3R ###############################

# CSF3R expression
CSF3R_ensembl <- "ENSG00000119535"
CSF3R_vector <- txi.data.239$abundance %>%
  as.data.frame() %>%
  slice(match(CSF3R_ensembl, rownames(.))) %>%
  select(all_of(intersect(colnames(.), patients.kept))) %>%
  unlist()

# df to go off of
csf3r_df <- data.frame(
  CSF3R = CSF3R_vector,
  row.names = names(CSF3R_vector)
)
csf3r_df$ptid <- rownames(csf3r_df)
pred_df_with_id <- pred.df %>% mutate(ptid = rownames(pred.df))

results.df <- inner_join(pred_df_with_id, csf3r_df, by = "ptid") %>%
  `rownames<-`(.$ptid)


# Part 2: Pathogen abundance -> perform ROC ####################################

rpm_df <- data.frame(
  RPM = rpm_sums,
  row.names = names(rpm_sums)
)
rpm_df$ptid <- rownames(rpm_df)
rpm_df_with_id <- rpm_df %>% mutate(ptid = rownames(rpm_df))

results.df <- inner_join(results.df, rpm_df_with_id, by = "ptid") %>%
  `rownames<-`(.$ptid) %>%
  select(-ptid)

# ROC function, run on both ####################################################

perform.roc <- function(df, predictor = 'CSF3R', predicted = 'Clinical Pathogen Abundance') {
  
  # Ensure outcome is a factor or binary numeric (0/1)
  outcome <- df[[predicted]]
  if (!is.numeric(outcome)) {
    outcome <- as.numeric(as.factor(outcome)) - 1  # Converts to 0/1
  }
  
  print(df[[predictor]])
  print(outcome)
  
  # Run ROC
  roc_obj <- roc(response = outcome, predictor = df[[predictor]], direction = "<")
  
  # Get AUC
  auc_val <- auc(roc_obj)
  
  # Get optimal threshold (Youden’s J = max(sens + spec - 1))
  coords_df <- coords(roc_obj, x = "best", best.method = "youden", ret = c("threshold", "sensitivity", "specificity"), transpose = FALSE)
  optimal_threshold <- coords_df$threshold
  
  return(list(
    roc = roc_obj,
    auc = auc_val,
    threshold = optimal_threshold
  ))
}

# 1) -> host response
host_response_result <- perform.roc(results.df, predictor = 'CSF3R', predicted = 'RNA-Seq Host Response Cluster')
host_response_auc_thres <- host_response_result$threshold
results.df$hr_positive <- sapply(results.df$CSF3R, function(x) ifelse(x >= host_response_auc_thres, TRUE, FALSE))
host_response_auc_thres

