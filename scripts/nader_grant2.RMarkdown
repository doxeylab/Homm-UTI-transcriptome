### How do the gene models perform on validation patients?

```{r validation testing}

# Function to predict the validation

predict_validation <- function(model_obj, validation_abund, validation_class_vector = NULL) {
  library(pROC)

  top_genes <- model_obj$top_genes
  rf_model <- model_obj$final_model
  
  # Subset validation to those genes
  common_genes <- intersect(top_genes, rownames(validation_abund))
  if (length(common_genes) < length(top_genes)) {
    warning("Some genes missing in validation data.")
  }
  
  val_df <- as.data.frame(t(validation_abund[common_genes, , drop = FALSE]))
  
  # Make predictions
  probs <- predict(rf_model, val_df, type = "prob")[, 2]
  preds <- ifelse(probs >= 0.5, 1, 0)
  
  result <- data.frame(Sample = rownames(val_df), Prob = probs, Pred = preds)
  
  # If you have ground truth, compute AUC
  if (!is.null(validation_class_vector)) {
    true <- validation_class_vector
    print(true)
    result$True <- true
    print(result)
    auc_val <- auc(roc(true, probs))
    attr(result, "validation_auc") <- auc_val
  }
  
  return(result)
}

# Actually calling the function

validation_abund <- Vtxi$abundance[ , validation_patients]
val_binary_enrleuks <- val_metadata[validation_patients , ]
val_binary_enrleuks <- sapply(val_binary_enrleuks$enrleuks, function(x) ifelse(x > 1, 1, 0))

val_pred_5gene <- predict_validation(
  model_obj = unsupervised_model_3_gene,
  validation_abund = validation_abund
)
rownames(val_pred_5gene) <- val_pred_5gene$Sample
rownames(val_metadata) <- val_metadata$ptid

val_pred_5gene$enrleuks <- val_binary_enrleuks

table(val_pred_5gene$Pred, val_pred_5gene$enrleuks)

# Across the board

unsupervised_models <- list(
  "Top_1" = unsupervised_model_1_gene,
  "Top_2" = unsupervised_model_2_gene,
  "Top_3" = unsupervised_model_3_gene,
  "Top_5" = unsupervised_model_5_gene,
  "Top_10" = unsupervised_model_10_gene,
  "Top_20" = unsupervised_model_20_gene
)

unsupervised_validation_results <- lapply(unsupervised_models, function(model_obj) {
  predict_validation(model_obj, validation_abund = validation_abund, validation_class_vector = val_binary_enrleuks)
})

# library(pROC)

validation_aucs <- sapply(names(validation_results), function(name) {
  df <- validation_results[[name]]
  
  print(table(df$True, df$Pred))
  
  if (!("True" %in% names(df))) {
    return(NA)
  }
  
  true <- df$True
  probs <- df$Prob
  
  # skip if only one class present
  if (length(unique(true)) < 2) {
    warning(paste("Skipping", name, "- only one class in True labels"))
    return(NA)
  }
  
  auc_val <- auc(roc(true, probs))
  auc_val
})

validation_aucs


